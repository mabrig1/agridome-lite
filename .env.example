# AgriDome Lite — Vercel / local environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/agridome_lite?retryWrites=true&w=majority

# Signed farmer sessions (generate a random value of at least 32 characters)
AUTH_SESSION_SECRET=

# Weather intelligence
OPENWEATHER_API_KEY=

# Paystack subscriptions
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_PRO_PLAN_CODE=
# Required by Paystack transaction initialize; the plan amount takes precedence.
PAYSTACK_PRO_AMOUNT_SUBUNIT=

# Phone OTP — Termii is preferred when configured
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic

# Optional Twilio Verify fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional general messaging
TWILIO_FROM_NUMBER=
