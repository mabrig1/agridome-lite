# AgriDome Lite — Vercel / local environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/agridome_lite?retryWrites=true&w=majority

# Weather intelligence
OPENWEATHER_API_KEY=

# Paystack subscriptions
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_PRO_PLAN_CODE=

# Optional messaging integrations
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
